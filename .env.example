# --- Application ---
APP_NAME=Atelier Couture API

# --- Base de données (utilisée par docker-compose) ---
POSTGRES_USER=atelier
POSTGRES_PASSWORD=change_me
POSTGRES_DB=atelier
POSTGRES_PORT=5432
# --- Tests ---
TEST_DATABASE_URL=postgresql+psycopg://atelier:change_me@localhost:5432/atelier_test

# --- Connexion SQLAlchemy ---
# Format : postgresql+psycopg://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL=postgresql+psycopg://atelier:change_me@localhost:5432/atelier

# --- JWT ---
JWT_SECRET_KEY=change_me_genere_une_cle_longue
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Premier administrateur (python -m app.seed) ---
ADMIN_EMAIL=admin@atelier.sn
ADMIN_PASSWORD=change_me
ADMIN_NOM_COMPLET=Mamadou Administrateur